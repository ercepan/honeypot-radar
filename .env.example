# Bu dosyayı ".env" olarak kopyala ve doldur.

# Boş bırakırsan yerel SQLite kullanılır (geliştirme için yeterli).
# ÜRETİMDE ŞART: Render'da kalıcı disk yok, SQLite sıfırlanır.
# Ücretsiz Postgres: supabase.com (500 MB, kart istemiyor)
DATABASE_URL=

# İsteğe bağlı — dolandırıcıların "fon kaynağı" kümelemesi için.
# Yoksa kümeleme yalnızca kontratı açan cüzdan bazında yapılır.
BSCSCAN_API_KEY=

PORT=8000
